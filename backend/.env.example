AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODELS=us.anthropic.claude-3-5-haiku-20241022-v1:0
# Optional per-role model overrides. Each defaults to BEDROCK_MODEL.
# Example: run generation on Sonnet while analysis and review stay on Haiku:
# BEDROCK_GENERATION_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_ANALYSIS_MODEL=
# BEDROCK_REVIEW_MODEL=
GENERATION_TEMPERATURE=0.7
REVIEW_TEMPERATURE=0.1
ANALYSIS_TEMPERATURE=0.1
# Repairs are grounded in the slot's evidence chunks; set true to also attach
# the full source PDF to repair calls (slower and more expensive).
REPAIR_ATTACH_SOURCE_PDF=false
AI_REQUEST_INTERVAL_SECONDS=0.5
SECTION_GENERATION_CONCURRENCY=5
BEDROCK_MAX_OUTPUT_TOKENS=24000
# How many PDF pages the analysis request may carry. Two provider limits bite:
# a hard 100-page ceiling, and the model's context window — and 100 pages of PDF
# is roughly a whole 200K window on its own. The page count is therefore derived
# from the window rather than fixed, which gives 55 pages on Claude Haiku 4.5.
# To send more, move the analysis call to a wider-context model:
#   BEDROCK_ANALYSIS_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   BEDROCK_CONTEXT_TOKENS=1000000
# BEDROCK_CONTEXT_TOKENS=200000
# BEDROCK_RESERVED_TOKENS=70000     # reply + chunk catalog + figures + prompt
# TOKENS_PER_PDF_PAGE=3500          # conservative mixed text/diagram page cost
# CHUNK_CATALOG_CHARS=40000         # preview budget shared across all chunks
# MAX_ATTACHED_PDF_PAGES=            # set only to override the derived budget
# Upload and response timeouts are separate. urllib3 uses the connect timeout
# while writing the request body too, so PDFs on slower links need more than the
# 30-second botocore default. Large analyses also need a long response window.
BEDROCK_CONNECT_TIMEOUT_SECONDS=120
BEDROCK_READ_TIMEOUT_SECONDS=600
AI_OUTPUT_RETRIES=2
QUESTION_PROVIDER_ATTEMPTS=3
MAX_VISUAL_CANDIDATES=12
# Maximum unresolved academic candidates to reassess one image at a time after
# batch analysis. This prevents asset-id drift without one call per extracted image.
MAX_VISUAL_REASSESSMENTS=4
LOG_GENERATED_QUESTIONS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TARGET_QUESTION_QUALITY_SCORE=85
TEST_PAPER_OUTPUT_DIR=../test_papers
PDF_OUTPUT_DIR=../outputs
# SQLite database and managed uploads for the single-machine product demo.
DEMO_DATA_DIR=../demo_data
